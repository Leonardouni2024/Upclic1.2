# UPCLIC.STORE - Configuración de Variables de Entorno (.env.example)
# Copia este archivo a .env y completa las credenciales reales de producción.

# --- 1. Pasarela de Pago: Mercado Pago (Perú - Soles S/) ---
MERCADOPAGO_ACCESS_TOKEN=
VITE_MP_PUBLIC_KEY=

# --- 2. Notificaciones por Correo Electrónico (SMTP) ---
SMTP_USER=
SMTP_PASS=

# --- 3. Analítica y Conversiones (Opcional, también configurable en Panel Admin) ---
VITE_GA4_MEASUREMENT_ID=
VITE_META_PIXEL_ID=

# --- 4. Seguridad del Panel de Administración ---
ADMIN_SECRET_TOKEN=


