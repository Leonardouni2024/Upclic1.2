{
  "entities": {
    "Review": {
      "title": "Review",
      "description": "A customer review for a product",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "author": { "type": "string" },
        "city": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "date": { "type": "string" },
        "isDemo": { "type": "boolean" },
        "verifiedPurchase": { "type": "boolean" }
      },
      "required": ["id", "productId", "author", "rating", "comment", "date"]
    }
  },
  "firestore": {
    "reviews/{reviewId}": {
      "schema": "#/entities/Review",
      "description": "Stores all customer reviews."
    }
  }
}
